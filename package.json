{
  "name": "ai-social-media-automation-system",
  "version": "0.1.0",
  "description": "Internal AI social media automation system",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --only firestore \"vitest run --config vitest.rules.config.ts\"",
    "test:e2e": "playwright test tests/e2e",
    "emulators": "firebase emulators:start --only firestore,auth",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build",
    "verify:services": "node --env-file=.env.local scripts/verify-services.mjs",
    "provision:user": "node --env-file=.env.local scripts/provision-user.mjs",
    "test:e2e:auth": "firebase emulators:exec --only auth,firestore \"npm run e2e:auth\"",
    "e2e:auth": "node --env-file=.env.local scripts/seed-e2e-user.mjs && playwright test tests/e2e-auth",
    "seed:sources": "node --env-file=.env.local scripts/seed-news-sources.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zaira-Shahid/AI-Social-Media-Automation-System.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Zaira-Shahid/AI-Social-Media-Automation-System/issues"
  },
  "homepage": "https://github.com/Zaira-Shahid/AI-Social-Media-Automation-System#readme",
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@resvg/resvg-js": "^2.6.2",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.11.0",
    "clsx": "^2.1.1",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "lucide-react": "^1.37.0",
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rss-parser": "^3.13.0",
    "satori": "^0.33.4",
    "shadcn": "^4.19.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "server-only": "^0.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "private": true,
  "overrides": {
    "uuid": "^11.1.1"
  }
}
