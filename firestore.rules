rules_version = '2';

// Firestore Security Rules — baseline (spec §33).
//
// Default-deny. Nothing is readable or writable by any client until a later
// module opens a collection explicitly and narrowly. Starting closed means no
// collection is ever accidentally world-readable during development.
//
// Two things these rules deliberately do NOT do:
//
//   1. They do not apply to the Firebase Admin SDK, which bypasses rules
//      entirely. Every server path using the Admin SDK must perform its own
//      authorization check.
//   2. They will never permit a client to write a `status` field on content
//      or platform post documents. Status transitions (§17) are enforced
//      server-side only.
//
// Roles come from Firebase Auth custom claims (request.auth.token.role), set
// only from a trusted server environment (§27, Module 01).

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function hasRole(role) {
      return signedIn() && request.auth.token.role == role;
    }

    // Profiles (§32). Read-only to clients, and only ever the owner's own
    // document or an ADMIN's view of anyone's.
    //
    // No client write at any role, ADMIN included. `role` and `status` live
    // on this document, so a writable profile would let a user promote
    // themselves — or re-enable their own disabled account. Provisioning goes
    // through the Admin SDK (§26).
    match /profiles/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || hasRole('ADMIN'));
      allow write: if false;
    }

    // Brand profile (§11). Readable by any signed-in user, because previews
    // and generation UI in later modules all need the brand identity.
    //
    // No client write at any role, ADMIN included. Writes go through the
    // server action, which is where the §31 validation lives — a client
    // write would bypass it and store a brand the renderer cannot use.
    match /companySettings/{document} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /brandSettings/{document} {
      allow read: if signedIn();
      allow write: if false;
    }

    // News sources (§5) and normalized items (§6). Readable by any signed-in
    // user; the news screen and the shortlist both need them.
    //
    // No client write. Sources go through the server action that validates
    // them, and `status` on an item is server-controlled — §33 forbids a client
    // writing status anywhere.
    match /newsSources/{document} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /newsItems/{document} {
      allow read: if signedIn();
      allow write: if false;
    }

    // The daily selection (§8, §46). Readable by any signed-in user — the news
    // screen shows which three stories were chosen, and by whom.
    //
    // No client write at any role. "Exactly three" and "not a rejected story"
    // are validated in the server action (§31); a client write would bypass
    // both, and the item statuses it has to keep in step would drift.
    match /selectedNews/{document} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Generated content (§12, §17, §32). Readable by any signed-in user — the
    // review queue and the previews both need it.
    //
    // No client write at any role. §17 is explicit that a client must never
    // write `status` on a platform post, and the same reasoning covers the
    // copy: a caption a browser can rewrite is not the caption anybody
    // approved. Generation, editing and approval all go through server code.
    match /contentItems/{document} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /platformPosts/{document} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Version history is the record of what was generated and when. A client
    // that can write it can rewrite what a reviewer saw (§55).
    match /contentVersions/{document} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Automation run records (§41, §45). Server-only, like the audit log — a
    // client that can write these can forge the operational history.
    match /automationRuns/{document} {
      allow read, write: if false;
    }

    // Notification delivery records (§9). Server-only for the same reason as
    // automation runs: a client that can write these can claim the team was
    // told about a shortlist it never saw (§67). The news screen reads them
    // through the Admin SDK, not from the browser.
    match /notificationLogs/{document} {
      allow read, write: if false;
    }

    // Audit logs (§55) are server-only. Denied outright, including reads: an
    // audit trail a client can read is a map of who did what, and one a
    // client can write is not evidence of anything (§33).
    match /auditLogs/{entry} {
      allow read, write: if false;
    }

    // Everything else stays closed. Later modules open collections
    // explicitly; nothing is granted by a broad wildcard (§33).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
