# Copy to .env.local and fill in real values. NEVER commit .env.local.
#
# Two groups, deliberately separated (spec §57):
#   NEXT_PUBLIC_* is bundled into the browser build and is NOT secret.
#   Everything else is server-only and MUST NOT reach the client.

# --- Firebase client config (safe to expose in the browser bundle) ---
# Firebase console -> Project settings -> General -> Your apps -> Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firestore database ID. Optional; defaults to "(default)" on both sides.
# The parentheses are part of the literal name Google gives a project's first
# database. Multi-database Firestore also allows plain IDs, and a database
# created as "default" is a DIFFERENT database — pointing at the wrong one
# fails as a bare "5 NOT_FOUND" that names neither. Confirm the real ID with:
#   firebase firestore:databases:list --project <project-id>
# NEXT_PUBLIC_FIREBASE_DATABASE_ID=(default)

# --- Firebase Admin (SERVER ONLY) ---
# From the service account JSON: Project settings -> Service accounts.
# Send the three fields below, not the JSON file.
# FIREBASE_ADMIN_PRIVATE_KEY keeps its literal \n sequences and is quoted.
# The Admin SDK bypasses Firestore Security Rules entirely (§33) — this is
# the highest-privilege secret in the system.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=""

# --- Cloudinary (SERVER ONLY) ---
# Storage for generated static post images (§28). Uploads are signed
# server-side; the API secret must never reach the browser.
# Must match NEXT_PUBLIC_FIREBASE_DATABASE_ID above.
# FIREBASE_DATABASE_ID=(default)

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Application ---
# IANA timezone. Stored config, never hardcoded (§54).
APP_TIMEZONE=Asia/Karachi

# 32-byte key, hex-encoded (64 hex chars). Used to encrypt OAuth tokens at
# rest before writing them to Firestore (§19).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# --- Facebook (SERVER ONLY) ---
# Publishing to the company Facebook Page (§19, §20). "mock" is the default
# and reaches nothing; set to "graph" to publish for real. The app secret is
# used only to exchange a short-lived user token for a long-lived one, never
# sent to the client and never given to n8n.
FACEBOOK_PROVIDER=mock
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- Instagram (SERVER ONLY) ---
# Publishing to the company Instagram professional account (§19, §20). Its own
# switch, because the Page and the Instagram account are separate connections
# that can be enabled separately. There is no second app: the Instagram account
# is reached through the Page it is linked to, so it reuses FACEBOOK_APP_ID and
# FACEBOOK_APP_SECRET above. "mock" is the default and reaches nothing.
INSTAGRAM_PROVIDER=mock

# Shared secret for verifying signed webhooks from n8n (§44).
# First used in Module 03.
N8N_WEBHOOK_SECRET=

# Firebase Auth session cookie lifetime in days (§26). Optional; defaults to
# 5. Firebase supports 5 minutes (0.0035) to 14 days.
SESSION_COOKIE_MAX_AGE_DAYS=5

# --- Local emulators (development and tests only) ---
# Set these to run against the Firebase Emulator Suite instead of the live
# project. Leave BOTH unset in any deployed environment.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1

# --- AI provider (SERVER ONLY) ---
# "mock" simulates every AI call (§21) and needs no key — the default, so
# development and CI never reach a live service. Set to "groq" for real calls.
AI_PROVIDER=mock

# Required only when AI_PROVIDER=groq. Free plan, no card:
# https://console.groq.com — 30 req/min, 8,000 tokens/min, 1,000 req/day
# on openai/gpt-oss-120b (verified 2026-08-31).
# GROQ_API_KEY=

# Optional. Must be a model that supports strict JSON-schema output.
# Defaults to openai/gpt-oss-120b.
# AI_MODEL=

# --- Slack (SERVER ONLY) ---
# Internal notification channel (§9). "mock" logs the message instead of
# sending it — the default, so development and CI never post to a real
# workspace. Set to "slack" to deliver for real.
SLACK_PROVIDER=mock

# Required only when SLACK_PROVIDER=slack.
#   1. Create an app at https://api.slack.com/apps (From scratch).
#   2. OAuth & Permissions -> Bot Token Scopes -> add chat:write.
#   3. Install to the workspace and copy the Bot User OAuth Token (xoxb-...).
#   4. Invite the app to the channel: /invite @your-app
# The bot posts with chat.postMessage; Slack allows about one message per
# second per channel (verified against Slack's docs, 2026-09-01).
# SLACK_BOT_TOKEN=

# The channel the daily shortlist is posted to. Use the channel ID (Cxxxxxxxx,
# from the channel's "View channel details"), not the #name — a renamed
# channel keeps its ID.
# SLACK_NEWS_CHANNEL_ID=

# Public base URL of this app. Only used to build the links inside a Slack
# message, so a wrong value produces a dead link, not a security problem.
# Defaults to http://localhost:3000.
# APP_BASE_URL=https://your-app.onrender.com
